# Fit Factory — Vacation Tracker — environment variables
#
# Both variables are server-only (no NEXT_PUBLIC_ prefix): the browser never
# talks to Supabase directly, it only calls this app's own /api/* routes.
# Those routes use the service role key to read/write the database. This
# keeps the database completely unreachable from outside the app, so we
# don't need Row Level Security policies for the trusted-team access model
# this app uses (see README.md "Access model").
#
# Get both values from: Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
